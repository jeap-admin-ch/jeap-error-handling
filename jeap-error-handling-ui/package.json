{
  "title": "JEAP Error Handling UI",
  "name": "jeap-error-handling-ui",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "organization": {
    "name": "Federal Office of Information Technology, Systems and Telecommunication FOITT",
    "url": "http://www.bit.admin.ch/"
  },
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "npm run check-licenses && npm run generateLicenseFile && ng build --base-href /error-handling/ --deploy-url /error-handling/",
    "build-dev": "npm run check-licenses && npm run generateLicenseFile && ng build -c dev --base-href /error-handling/ --deploy-url /error-handling/",
    "build-prod": "npm run check-licenses && npm run generateLicenseFile && ng build -c production --base-href /error-handling/ --deploy-url /error-handling/",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watchAll",
    "lint": "ng lint",
    "check-licenses": "jeap-frontend-license-checker",
    "generateLicenseFile": "jeap-frontend-license-checker notices && jeap-frontend-license-checker notices --out src/assets/THIRD-PARTY-LICENSES.md --texts folder --texts-dir third-party-licenses"
  },
  "jest": {
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "jestSonar": {
    "reportPath": "./coverage/sonarQube",
    "reportFile": "sqr.xml",
    "indent": 4,
    "sonar56x": true
  },
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/localize": "^21.2.19",
    "@angular/material": "^21.2.3",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@oblique/oblique": "^15.1.2",
    "@popperjs/core": "^2.11.8",
    "@quadrel-enterprise-ui/auth": "^20.1.3",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/ws": "^8.18.1",
    "ajv": "^8.12.0",
    "angular-oauth2-oidc": "^22.0.0",
    "date-fns": "^4.0.0",
    "fast-deep-equal": "^3.1.3",
    "js-cookie": "^3.0.7",
    "json-schema-traverse": "^1.0.0",
    "jwt-decode": "^4.0.0",
    "rxjs": "^7.8.0",
    "sass": "^1.93.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.19",
    "@jeap/jeap-frontend-license-checker": "^1.0.1",
    "@ngtools/json-schema": "^1.1.0",
    "@schematics/angular": "^21.2.3",
    "@types/jest": "^30.0.0",
    "commander": "^15.0.0",
    "conventional-changelog": "^8.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^17.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "node-gyp": "^13.0.0",
    "simple-git": "^3.36.0",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "tslint": "~6.1.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "4.1.3",
    "set-value": "4.1.0",
    "picomatch": "4.0.5"
  }
}
